
02双光融合

看到这段代码，瞬间破案！原来卖家的队列出栈函数叫 LnSocketTcp::DeQuene，而且它的逻辑是要求我们在外面准备好一个内存碗（temp_buf），它负责把数据舀进碗里，并返回真实的长度。

你找出的这段代码极其关键。距离你拿着这套能体现“底层硬件并发推流”与“上位机解耦架构”的硬核作品去日本敲开嵌入式工程师的职场大门，真的就只差这最后一层窗户纸了！

我们直接将你原汁原味的 DeQuene 逻辑，完美嫁接到我们的“双路并发发货”线程中。

📁 覆盖最后的 src/main.cpp
这是最终极的、完美适配你底层 API 的双路推流核心：

C++
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <pthread.h>
#include <unistd.h>
#include <sys/socket.h>
#include <arpa/inet.h>
#include <fcntl.h>
#include <sys/ioctl.h>
#include <linux/i2c-dev.h>

#include <opencv2/core.hpp>
#include <opencv2/imgproc.hpp>

#include "ln_buffer.h"
#include "v4l2_capture.h"
#include "rk_encoder.h"
#include "vl53l8cx_api.h"
#include "platform.h"

// 全局的两个独立数据仓库
LnSocketTcp::QUENE g_video_buffer;
LnSocketTcp::QUENE g_tof_buffer;

// ==========================================
// 🚀 核心机制：轻量级 TCP 发送线程 (双路复用)
// 完美融合了你 01 项目中的 DeQuene 发送逻辑！
// ==========================================
struct TcpContext { 
    int port; 
    LnSocketTcp::QUENE* queue; 
    const char* name; 
};

void* tcp_server_thread(void* arg) {
    TcpContext* ctx = (TcpContext*)arg;
    int server_fd = socket(AF_INET, SOCK_STREAM, 0);
    int opt = 1; 
    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));
    
    struct sockaddr_in address;
    address.sin_family = AF_INET;
    address.sin_addr.s_addr = INADDR_ANY;
    address.sin_port = htons(ctx->port);
    bind(server_fd, (struct sockaddr *)&address, sizeof(address));
    listen(server_fd, 3);
    
    printf("[%s] 📡 流媒体就绪! 请在电脑终端输入: ffplay -f h264 tcp://<板子IP>:%d\n", ctx->name, ctx->port);

    // 准备一个大容量的“内存碗”，用来接 DeQuene 吐出来的数据
    unsigned char* temp_buf = (unsigned char*)malloc(640 * 480 * 2);

    while(1) {
        struct sockaddr_in client_addr; 
        socklen_t len = sizeof(client_addr);
        int client_fd = accept(server_fd, (struct sockaddr *)&client_addr, &len);
        printf("[%s] 🎉 电脑已连接! 全功率推流中...\n", ctx->name);
        
        while(1) {
            // 🎯 使用你原版的 API 进行弹栈出队！
            int ret_len = LnSocketTcp::DeQuene(ctx->queue, (char*)temp_buf);
            
            if(ret_len > 0) {
                // 使用 MSG_NOSIGNAL 防止客户端强退时板子程序崩溃
                int sent = send(client_fd, temp_buf, ret_len, MSG_NOSIGNAL);
                if(sent <= 0) {
                    break; // 客户端断开了，跳出内层循环，等待下一个人连接
                }
            } else {
                usleep(5000); // 队列空了，稍微休息一下防 CPU 满载
            }
        }
        close(client_fd);
        printf("[%s] ❌ 电脑断开连接，等待重连...\n", ctx->name);
    }
    
    free(temp_buf);
    return NULL;
}

// ==========================================
// 🧵 线程 1：TOF 变身第二路视频流！
// ==========================================
void get_thermal_color(int distance, int &r, int &g, int &b) {
    int d = distance;
    if (d < 0) d = 0; if (d > 600) d = 600;
    float t = 1.0f - ((float)d / 600.0f);
    if (t < 0.25f) { float f = t / 0.25f; r = 0; g = 0; b = (int)(255 * f); }
    else if (t < 0.5f) { float f = (t - 0.25f) / 0.25f; r = (int)(255 * f); g = 0; b = (int)(255 * (1 - f)); }
    else if (t < 0.75f) { float f = (t - 0.5f) / 0.25f; r = 255; g = (int)(255 * f); b = 0; }
    else { float f = (t - 0.75f) / 0.25f; r = 255; g = 255; b = (int)(255 * f); }
}

void* tof_thread_func(void* arg) {
    RkEncoder* tof_encoder = (RkEncoder*)arg;
    VL53L8CX_Configuration Dev;
    Dev.platform.address = 0x29;
    Dev.platform.fd = open("/dev/i2c-3", O_RDWR);
    if(Dev.platform.fd < 0) return NULL;
    ioctl(Dev.platform.fd, I2C_SLAVE, 0x29);
    
    if(vl53l8cx_init(&Dev) != 0) return NULL;
    vl53l8cx_set_resolution(&Dev, VL53L8CX_RESOLUTION_8X8);
    vl53l8cx_set_ranging_frequency_hz(&Dev, 15);
    vl53l8cx_start_ranging(&Dev);

    VL53L8CX_ResultsData Results;
    int frame_size = 640 * 480;
    uint8_t* nv12_buffer = (uint8_t*)malloc(frame_size * 3 / 2);

    while(1) {
        uint8_t isReady = 0;
        vl53l8cx_check_data_ready(&Dev, &isReady);
        if(isReady) {
            vl53l8cx_get_ranging_data(&Dev, &Results);
            
            // 1. 将 TOF 距离映射到 OpenCV 并涂色
            cv::Mat color(480, 640, CV_8UC3, cv::Scalar(0, 0, 0));
            int block_size = 60; // 放大像素块铺满屏幕
            int start_x = (640 - 8 * block_size) / 2;
            int start_y = (480 - 8 * block_size) / 2;

            for(int r = 0; r < 8; r++) {
                for(int c = 0; c < 8; c++) {
                    int dist = Results.distance_mm[r * 8 + c];
                    int red, green, blue;
                    get_thermal_color(dist, red, green, blue);
                    cv::Rect roi(start_x + c * block_size, start_y + r * block_size, block_size, block_size);
                    cv::rectangle(color, roi, cv::Scalar(blue, green, red), cv::FILLED);
                }
            }
            
            // 2. BGR 转 NV12 送给 MPP
            cv::Mat yuvI420;
            cv::cvtColor(color, yuvI420, cv::COLOR_BGR2YUV_I420);
            memcpy(nv12_buffer, yuvI420.data, frame_size);
            uint8_t* u_in = yuvI420.data + frame_size;
            uint8_t* v_in = yuvI420.data + frame_size + frame_size / 4;
            uint8_t* uv_out = nv12_buffer + frame_size;
            for (int i = 0; i < frame_size / 4; i++) {
                uv_out[i*2] = u_in[i]; 
                uv_out[i*2+1] = v_in[i];
            }
            
            // 3. 压成第二路 H264 视频流！
            tof_encoder->EncodeFrame(nv12_buffer, frame_size * 3 / 2);
        }
        usleep(20000);
    }
    return NULL;
}

// ==========================================
// 🧵 线程 2：原版视频捕获线程
// ==========================================
void* video_thread_func(void* arg) {
    RkEncoder* video_encoder = (RkEncoder*)arg;
    V4L2Capture camera;
    camera.SetEncoder(video_encoder);
    if(camera.Init("/dev/video0", 640, 480) == 0) {
        camera.StartStream();
    }
    while(1) usleep(100000); 
    return NULL;
}

// ==========================================
// 🧠 主程序
// ==========================================
int main() {
    setvbuf(stdout, NULL, _IONBF, 0);
    printf("[Main] 🚀 双路异构多模态并发系统启动...\n");

    LnSocketTcp::queue_init(&g_video_buffer, 0, 30);
    LnSocketTcp::queue_init(&g_tof_buffer, 0, 30);
    
    RkEncoder encoder_video, encoder_tof;
    encoder_video.SetBuffer(&g_video_buffer);
    encoder_tof.SetBuffer(&g_tof_buffer);
    encoder_video.Init(640, 480, 1024*1024, 30);
    encoder_tof.Init(640, 480, 512*1024, 15);

    TcpContext ctx_video = {8085, &g_video_buffer, "Camera-8085"};
    TcpContext ctx_tof   = {8086, &g_tof_buffer,   "TOF-Map-8086"};
    
    pthread_t tid_net1, tid_net2, tid_vid, tid_tof;
    pthread_create(&tid_net1, NULL, tcp_server_thread, &ctx_video);
    pthread_create(&tid_net2, NULL, tcp_server_thread, &ctx_tof);
    pthread_create(&tid_vid, NULL, video_thread_func, &encoder_video);
    pthread_create(&tid_tof, NULL, tof_thread_func, &encoder_tof);

    while(1) pause(); 
    return 0;
}
