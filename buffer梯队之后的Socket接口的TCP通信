我们现在已经打通了“任督二脉”：摄像头在源源不断地采集，硬件在疯狂且零负担地压缩，数据乖乖地在环形队列里排队。

这是最后的“终极一战”：让这股数据洪流顺着网线，冲进你的电脑屏幕！
为了让你简历上的含金量达到最高，我建议我们不要用别人买来的那种封装得花里胡哨的 socket 库。
我们要直接使用 Linux 最底层的标准 POSIX C Socket 接口。只有懂底层 Socket 的人，才算真正懂网络编程。

只要两步，我们就能在电脑上看到实时的画面！

🛠️ 第一步：改造“物流线程”，把包裹丢进网线
打开 src/Media_Process_Thread.cpp，加上 Socket 发送相关的代码。
它的逻辑非常简单：只要有个叫做 g_client_fd 的客户连接了，我们就用 send() 函数把 H.264 视频流砸给他！
C++
#include <stdlib.h>
#include <unistd.h>
#include <stddef.h>
#include <stdio.h>
#include <sys/socket.h> // 新增底层网络头文件
#include "ln_buffer.h"
extern LnSocketTcp::QUENE g_video_buffer;
bool g_is_running = true; 
// 全局的客户端 Socket 句柄（初始为 -1 表示没人连接）
int g_client_fd = -1;
void* Media_Process_Thread(void* arg) {
    unsigned char* temp_buf = (unsigned char*)malloc(640 * 480 * 2); 

    while (g_is_running) {
        int ret_len = LnSocketTcp::DeQuene(&g_video_buffer, (char*)temp_buf);
        
        if (ret_len > 0) { 
            // 如果有客户端连进来了，就开始疯狂推流！
            if (g_client_fd > 0) {
                // 用 send 函数把这帧 H.264 数据发给电脑
                int sent = send(g_client_fd, temp_buf, ret_len, 0)
                
                if (sent <= 0) {
                    printf("❌ 客户端断开连接！停止推流。\n");
                    close(g_client_fd);
                    g_client_fd = -1; // 置空，等待下一个客户端连接
                }
            }
        } else {
            usleep(5000); 
        }
    }
    free(temp_buf);
    return NULL;
}
🛠️ 第二步：改造“总指挥”，化身 TCP 服务器
打开 src/main.cpp，在启动完摄像头后，我们让主线程变成一个 TCP 服务器（监听 8080 端口）。就像开了一家店，等待你的 Windows 电脑推门进来。
C++
#include <stdio.h>
#include <unistd.h>
#include <pthread.h>
#include <string.h>
#include <sys/socket.h> // 新增网络套接字头文件
#include <arpa/inet.h>  // 新增 IP 地址转换头文件
#include "ln_buffer.h"
#include "v4l2_capture.h"
#include "rk_encoder.h"
extern void* Media_Process_Thread(void* arg); 
extern int g_client_fd; // 引用物流线程里的那个全局客户端句柄
LnSocketTcp::QUENE g_video_buffer;
int main() {
    printf("[Main] 🚀 系统启动中...\n");

    LnSocketTcp::queue_init(&g_video_buffer, 0, 30);
    
    RkEncoder encoder;
    encoder.SetBuffer(&g_video_buffer); 
    if (encoder.Init(640, 480, 1024*1024, 30) != 0) return -1;

    pthread_t media_tid;
    pthread_create(&media_tid, NULL, Media_Process_Thread, NULL);

    V4L2Capture camera;
    camera.SetEncoder(&encoder);
    if (camera.Init("/dev/video0", 640, 480) == 0) {
        camera.StartStream();
    }
    // ==========================================
    // 🌐 启动纯正的 Linux TCP Server，等待电脑连接
    // ==========================================
    int server_fd = socket(AF_INET, SOCK_STREAM, 0);    
    // 设置端口复用（防止程序重启时报“端口被占用”）
    int opt = 1;
    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt)); 
    struct sockaddr_in address;
    address.sin_family = AF_INET;
    address.sin_addr.s_addr = INADDR_ANY; // 监听板子上所有的网卡
    address.sin_port = htons(8080);       // 绑定到 8080 端口
    bind(server_fd, (struct sockaddr *)&address, sizeof(address));
    listen(server_fd, 3); // 开始监听
    printf("[Main] 📡 TCP 视频流流媒体服务器已启动！\n");
    printf("[Main] 👉 请在电脑上使用 VLC 打开: tcp://<开发板IP>:8080\n");
    // 主线程变成“迎宾员”，死循环等待客户端连接
    while(1) { 
        struct sockaddr_in client_addr;
        socklen_t client_addr_len = sizeof(client_addr);
        
        // 这一步会一直阻塞卡住，直到有电脑连进来
        int new_socket = accept(server_fd, (struct sockaddr *)&client_addr, &client_addr_len);

        if (new_socket > 0) {
            printf("\n[Main] 🎉 卧槽！电脑已连接！IP: %s，开始火力全开推流！\n", inet_ntoa(client_addr.sin_addr));          
            // 把连接好的套接字，交给物流线程去发数据
            g_client_fd = new_socket; 
        }
    }
    return 0;
}
