🔍 为什么会报错？（大厂最爱考的底层调优细节）
看这句核心报错：
mpp_enc: invalid bit per second 100000:1048576 min 0:0 max 0:0 out of range 1K~200M
原因剖析：
硬件编码器在处理码率（Bitrate, bps）时非常严格。之前我们图省事，只给它设置了一个目标码率 rc:bps_target = 1024*1024。
但是，硬件默认它的最大码率（bps_max）和最小码率（bps_min）是 0！
硬件一看：“你让我压到 1Mbps，但最大允许码率又是 0？这不合逻辑啊！”于是当场罢工，返回了 ret -6（非法参数错误）。
🛠️ 破局：给硬件一份“完美参数表”
既然硬件这么严谨，我们就给它最标准的工业级配置。在音视频开发中，这叫 VBR（动态码率控制） 设置。
请打开你的 src/rk_encoder.cpp，找到 Init 函数，把里面的参数配置部分（从 mpp_enc_cfg_init 到 m_mpi->control 之间）替换成下面这段“完美配置”：
C++
// ==========================================
// 1. 初始化函数 (只在启动时运行一次，放配置代码)
// ==========================================
int RkEncoder::Init(int width, int height, int bps, int fps) {
    m_width = width;
    m_height = height;

    int ret = mpp_create(&m_ctx, &m_mpi);
    if (ret) return -1;

    ret = mpp_init(m_ctx, MPP_CTX_ENC, MPP_VIDEO_CodingAVC);
    if (ret) return -1;

    // --- 这里才是完美配置表的正确位置 ---
    mpp_enc_cfg_init(&m_cfg);

    mpp_enc_cfg_set_s32(m_cfg, "prep:width", width);
    mpp_enc_cfg_set_s32(m_cfg, "prep:height", height);
    mpp_enc_cfg_set_s32(m_cfg, "prep:hor_stride", width);
    mpp_enc_cfg_set_s32(m_cfg, "prep:ver_stride", height);
    mpp_enc_cfg_set_s32(m_cfg, "prep:format", MPP_FMT_YUV420SP); // NV12

    mpp_enc_cfg_set_s32(m_cfg, "rc:mode", MPP_ENC_RC_MODE_VBR); 
    mpp_enc_cfg_set_s32(m_cfg, "rc:bps_target", bps);
    mpp_enc_cfg_set_s32(m_cfg, "rc:bps_max", bps * 17 / 16); 
    mpp_enc_cfg_set_s32(m_cfg, "rc:bps_min", bps * 15 / 16); 

    mpp_enc_cfg_set_s32(m_cfg, "rc:fps_in_flex", 0);
    mpp_enc_cfg_set_s32(m_cfg, "rc:fps_in_num", fps); 
    mpp_enc_cfg_set_s32(m_cfg, "rc:fps_in_den", 1);   
    mpp_enc_cfg_set_s32(m_cfg, "rc:fps_out_flex", 0);
    mpp_enc_cfg_set_s32(m_cfg, "rc:fps_out_num", fps); 
    mpp_enc_cfg_set_s32(m_cfg, "rc:fps_out_den", 1);   
    mpp_enc_cfg_set_s32(m_cfg, "rc:gop", fps * 2);     

    ret = m_mpi->control(m_ctx, MPP_ENC_SET_CFG, m_cfg);
    if (ret) {
        printf("mpp_enc_set_cfg failed!\n");
        return -1;
    }

    printf("✅ MPP 硬件编码器初始化成功!\n");
    return 0;
}

// ==========================================
// 2. 编码函数 (一秒钟运行30次，放压制和入队代码)
// ==========================================
int RkEncoder::EncodeFrame(void* nv12_data, int size) {
    if (!m_ctx || !m_mpi || !m_video_buffer) return -1;

    MPP_RET ret = MPP_OK;
    MppFrame frame = NULL;
    MppPacket packet = NULL;
    void *buf = NULL;
    MppBuffer mpp_buf = NULL;

    mpp_buffer_get(NULL, &mpp_buf, size);
    if (!mpp_buf) return -1;

    buf = mpp_buffer_get_ptr(mpp_buf);
    memcpy(buf, nv12_data, size);

    mpp_frame_init(&frame);
    mpp_frame_set_width(frame, m_width);
    mpp_frame_set_height(frame, m_height);
    mpp_frame_set_hor_stride(frame, m_width);
    mpp_frame_set_ver_stride(frame, m_height);
    mpp_frame_set_fmt(frame, MPP_FMT_YUV420SP);
    mpp_frame_set_buffer(frame, mpp_buf);
    mpp_frame_set_eos(frame, 0);

    ret = m_mpi->encode_put_frame(m_ctx, frame);
    if (ret) return -1;

    ret = m_mpi->encode_get_packet(m_ctx, &packet);
    if (ret || !packet) return -1;

    void *out_ptr = mpp_packet_get_pos(packet);
    size_t out_len = mpp_packet_get_length(packet);

    if (packet && out_len > 0) {
        printf("🔥 MPP 硬件压缩成功！原始: %d 字节 -> 压缩后 H.264: %zu 字节\n", size, out_len);
        LnSocketTcp::EnQuene(m_video_buffer, (char*)out_ptr, out_len);
    }

    mpp_packet_deinit(&packet);
    mpp_frame_deinit(&frame);
    mpp_buffer_put(mpp_buf);

    return 0;
}
