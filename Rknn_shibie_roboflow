请直接打开你的 **`v4l2_capture.cpp`**，用以下代码完全覆盖（核心的 NMS 解析、颜色转换和 RKNN 推理全在这个文件里闭环）：

```cpp
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/ioctl.h>
#include <sys/mman.h>
#include <linux/videodev2.h>
#include "v4l2_capture.h"

// 引入 OpenCV 和 RKNN 头文件
#include <opencv2/opencv.hpp>
#include <opencv2/dnn.hpp>
#include "rknn_api.h"

// ==========================================
// 1. 定义全局的 RKNN 句柄和后处理结构
// ==========================================
rknn_context g_rknn_ctx = 0;

struct DetectResult {
    cv::Rect box;
    float conf;
    int class_id;
};

// YOLOv8 后处理解析函数
std::vector<DetectResult> post_process_yolov8(float* output_data, int num_classes = 1, float conf_thresh = 0.25f, float iou_thresh = 0.45f) {
    std::vector<cv::Rect> boxes;
    std::vector<float> confs;
    std::vector<int> class_ids;
    int num_proposals = 8400; 

    for (int i = 0; i < num_proposals; ++i) {
        float max_class_conf = 0.0f;
        int current_class_id = -1;
        for (int c = 0; c < num_classes; ++c) {
            float conf = output_data[(4 + c) * num_proposals + i];
            if (conf > max_class_conf) {
                max_class_conf = conf;
                current_class_id = c;
            }
        }
        if (max_class_conf > conf_thresh) {
            float cx = output_data[0 * num_proposals + i];
            float cy = output_data[1 * num_proposals + i];
            float w  = output_data[2 * num_proposals + i];
            float h  = output_data[3 * num_proposals + i];

            int left = static_cast<int>(cx - w / 2.0f);
            int top  = static_cast<int>(cy - h / 2.0f);
            boxes.push_back(cv::Rect(left, top, static_cast<int>(w), static_cast<int>(h)));
            confs.push_back(max_class_conf);
            class_ids.push_back(current_class_id);
        }
    }

    std::vector<int> indices;
    cv::dnn::NMSBoxes(boxes, confs, conf_thresh, iou_thresh, indices);

    std::vector<DetectResult> final_results;
    for (int idx : indices) {
        DetectResult res;
        res.box = boxes[idx];
        res.conf = confs[idx];
        res.class_id = class_ids[idx];
        final_results.push_back(res);
    }
    return final_results;
}

// ==========================================
// 2. 原版 V4L2 生命周期函数
// ==========================================
V4L2Capture::V4L2Capture() : m_fd(-1), m_is_running(false), m_buffers(NULL), m_buf_count(4), m_thread_id(0), m_encoder(NULL) {}

V4L2Capture::~V4L2Capture() {
    if(m_is_running) StopStream();
    if (m_buffers != NULL) {
        for (unsigned int i = 0; i < m_buf_count; ++i) {
            if (m_buffers[i].start) munmap(m_buffers[i].start, m_buffers[i].length);
        }
        free(m_buffers); m_buffers = NULL;
    }
    if (m_fd >= 0) { close(m_fd); m_fd = -1; }
    // 释放 NPU 资源
    if (g_rknn_ctx != 0) { rknn_destroy(g_rknn_ctx); g_rknn_ctx = 0; }
}

int V4L2Capture::Init(const char* dev_name, int width, int height) {
    m_width = width; m_height = height;
    m_fd = open(dev_name, O_RDWR | O_NONBLOCK, 0);
    if (m_fd < 0) return -1;

    struct v4l2_format fmt;
    memset(&fmt, 0, sizeof(fmt));
    fmt.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
    fmt.fmt.pix_mp.width = width;
    fmt.fmt.pix_mp.height = height;
    fmt.fmt.pix_mp.pixelformat = V4L2_PIX_FMT_NV12; 
    fmt.fmt.pix_mp.field = V4L2_FIELD_ANY;
    if (ioctl(m_fd, VIDIOC_S_FMT, &fmt) < 0) return -1;

    struct v4l2_requestbuffers req;
    memset(&req, 0, sizeof(req));
    req.count = m_buf_count;
    req.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
    req.memory = V4L2_MEMORY_MMAP;
    if (ioctl(m_fd, VIDIOC_REQBUFS, &req) < 0) return -1;

    m_buffers = (struct MapBuffer*)calloc(req.count, sizeof(*m_buffers));
    for (unsigned int i = 0; i < req.count; ++i) {
        struct v4l2_buffer buf; struct v4l2_plane planes[1];
        memset(&buf, 0, sizeof(buf)); memset(planes, 0, sizeof(planes));
        buf.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
        buf.memory = V4L2_MEMORY_MMAP;
        buf.index = i; buf.m.planes = planes; buf.length = 1;
        if (ioctl(m_fd, VIDIOC_QUERYBUF, &buf) < 0) return -1;
        m_buffers[i].length = buf.m.planes[0].length;
        m_buffers[i].start = mmap(NULL, buf.m.planes[0].length, PROT_READ | PROT_WRITE, MAP_SHARED, m_fd, buf.m.planes[0].m.mem_offset);
        ioctl(m_fd, VIDIOC_QBUF, &buf);
    }

    // 💥 在这里初始化 RKNN 模型
    if (g_rknn_ctx == 0) {
        printf("[V4L2] 正在加载 best.rknn 模型...\n");
        int ret = rknn_init(&g_rknn_ctx, (void*)"best.rknn", 0, 0, NULL);
        if (ret < 0) printf("❌ RKNN 模型加载失败!\n");
        else printf("✅ RKNN 模型加载成功!\n");
    }

    return 0;
}

int V4L2Capture::StartStream() {
    enum v4l2_buf_type type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
    if (ioctl(m_fd, VIDIOC_STREAMON, &type) < 0) return -1;
    m_is_running = true;
    pthread_create(&m_thread_id, NULL, CaptureThread, this);
    return 0;
}

// ==========================================
// 3. 💥 核心拦截区：CaptureThread
// ==========================================
void* V4L2Capture::CaptureThread(void* arg) {
    V4L2Capture* cap = (V4L2Capture*)arg;
    struct v4l2_buffer buf; struct v4l2_plane planes[1];

    while (cap->m_is_running) {
        memset(&buf, 0, sizeof(buf)); memset(planes, 0, sizeof(planes));
        buf.type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
        buf.memory = V4L2_MEMORY_MMAP;
        buf.m.planes = planes; buf.length = 1;

        if (ioctl(cap->m_fd, VIDIOC_DQBUF, &buf) < 0) { usleep(10000); continue; }

        void* image_data = cap->m_buffers[buf.index].start;
        int image_size = buf.m.planes[0].bytesused;
        int frame_size = cap->m_width * cap->m_height;

        // ----------------------------------------------------
        // 步骤 A: 将摄像头的 NV12 提出来转成 BGR (画框用) 和 RGB (推理用)
        // ----------------------------------------------------
        cv::Mat nv12_img(cap->m_height * 3 / 2, cap->m_width, CV_8UC1, image_data);
        cv::Mat bgr_img, rgb_img, rknn_img;
        cv::cvtColor(nv12_img, bgr_img, cv::COLOR_YUV2BGR_NV12);
        cv::cvtColor(bgr_img, rgb_img, cv::COLOR_BGR2RGB);
        cv::resize(rgb_img, rknn_img, cv::Size(640, 640));

        // ----------------------------------------------------
        // 步骤 B: 喂给 NPU
        // ----------------------------------------------------
        if (g_rknn_ctx != 0) {
            rknn_input inputs[1];
            memset(inputs, 0, sizeof(inputs));
            inputs[0].index = 0;
            inputs[0].type = RKNN_TENSOR_UINT8;
            inputs[0].size = 640 * 640 * 3;
            inputs[0].fmt = RKNN_TENSOR_NHWC;
            inputs[0].buf = rknn_img.data;
            rknn_inputs_set(g_rknn_ctx, 1, inputs);

            rknn_run(g_rknn_ctx, NULL);

            rknn_output outputs[1];
            memset(outputs, 0, sizeof(outputs));
            outputs[0].want_float = 1;
            rknn_outputs_get(g_rknn_ctx, 1, outputs, NULL);

            // ----------------------------------------------------
            // 步骤 C: NMS 解析并在 BGR 原图上画框
            // ----------------------------------------------------
            std::vector<DetectResult> results = post_process_yolov8((float*)outputs[0].buf);
            for (auto& res : results) {
                // 坐标从 640 映射回实际分辨率
                int x = res.box.x * cap->m_width / 640;
                int y = res.box.y * cap->m_height / 640;
                int w = res.box.width * cap->m_width / 640;
                int h = res.box.height * cap->m_height / 640;
                cv::rectangle(bgr_img, cv::Rect(x, y, w, h), cv::Scalar(0, 255, 0), 2);
            }
            rknn_outputs_release(g_rknn_ctx, 1, outputs);
        }

        // ----------------------------------------------------
        // 步骤 D: 将画好框的 BGR 重新转回 NV12，丢给 MPP 编码！
        // （完全复用你 main.cpp tof_thread_func 里的绝妙转换逻辑）
        // ----------------------------------------------------
        cv::Mat yuvI420;
        cv::cvtColor(bgr_img, yuvI420, cv::COLOR_BGR2YUV_I420);
        
        uint8_t* nv12_buffer = (uint8_t*)malloc(image_size);
        memcpy(nv12_buffer, yuvI420.data, frame_size);
        uint8_t* u_in = yuvI420.data + frame_size;
        uint8_t* v_in = yuvI420.data + frame_size + frame_size / 4;
        uint8_t* uv_out = nv12_buffer + frame_size;
        for (int i = 0; i < frame_size / 4; i++) {
            uv_out[i*2] = u_in[i]; 
            uv_out[i*2+1] = v_in[i];
        }

        // ----------------------------------------------------
        // 步骤 E: 把带有 AI 框的 NV12 送进你的 MPP 硬件编码器
        // ----------------------------------------------------
        if (cap->m_encoder) cap->m_encoder->EncodeFrame(nv12_buffer, image_size);

        free(nv12_buffer); // 防止内存泄漏

        ioctl(cap->m_fd, VIDIOC_QBUF, &buf);
    }
    return NULL;
}

void V4L2Capture::StopStream() {
    m_is_running = false;
    if (m_thread_id != 0) { pthread_join(m_thread_id, NULL); m_thread_id = 0; }
    enum v4l2_buf_type type = V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE;
    ioctl(m_fd, VIDIOC_STREAMOFF, &type);
}

