📄 1. 编写驱动核心代码 tof_irq.c
这就是我们要写的内核模块源码。它实现了 I2C 驱动的挂载、中断的注册，以及中断触发时的响应：

C
#include <linux/module.h>
#include <linux/i2c.h>
#include <linux/interrupt.h>

// 定义一个结构体来保存我们的设备数据
struct tof_dev {
    struct i2c_client *client;
    int irq_num;
};

static struct tof_dev tof_data;

// ⚡ 核心大招：中断服务函数 (ISR)
// 当 TOF 传感器拉低 INT 引脚时，内核会瞬间打断正在运行的普通程序，跳转到这里执行！
static irqreturn_t tof_irq_handler(int irq, void *dev_id)
{
    // 这里就是替代你原来死循环里 if(isReady) 的地方
    // 只有数据真的准备好了，才会打印这句话
    printk(KERN_INFO "🎯 捕捉到 TOF 硬件中断触发！数据已就绪！\n");
    
    // 注意：在实际项目里，通常在这里释放一个信号量或等待队列，唤醒应用层去读取 I2C 数据
    return IRQ_HANDLED;
}

// 驱动与设备树匹配成功后，内核会自动调用 probe 函数
static int tof_probe(struct i2c_client *client, const struct i2c_device_id *id)
{
    int ret;
    
    printk(KERN_INFO "🔍 匹配到 TOF 传感器设备树节点！I2C 地址: 0x%x\n", client->addr);

    tof_data.client = client;

    // 享受内核红利：I2C 子系统已经帮我们解析好了设备树里的 interrupts 节点
    tof_data.irq_num = client->irq;
    
    if (tof_data.irq_num <= 0) {
        printk(KERN_ERR "❌ 未能在设备树中找到有效的中断号!\n");
        return -EINVAL;
    }
    
    printk(KERN_INFO "✅ 成功获取系统分配的虚拟中断号: %d\n", tof_data.irq_num);

    // 向内核注册中断，申请独占这个中断号
    ret = request_irq(tof_data.irq_num,
                      tof_irq_handler,
                      IRQF_TRIGGER_FALLING,  // 对应你在设备树里写的下降沿触发
                      "tof_interrupt",       // 名字，之后可以在 /proc/interrupts 里看到
                      &tof_data);
    if (ret) {
        printk(KERN_ERR "❌ 注册 TOF 中断失败: %d\n", ret);
        return ret;
    }

    printk(KERN_INFO "🚀 TOF 中断驱动加载成功，坐等传感器发信号...\n");
    return 0;
}

// 驱动卸载时调用
static int tof_remove(struct i2c_client *client)
{
    // 归还中断号给系统
    free_irq(tof_data.irq_num, &tof_data);
    printk(KERN_INFO "👋 TOF 中断驱动已安全卸载。\n");
    return 0;
}

// 🔑 设备树匹配表 (暗号必须和设备树里写的 compatible 完全一致)
static const struct of_device_id tof_of_match[] = {
    { .compatible = "alientek,tof-sensor" },
    { /* sentinel */ }
};
MODULE_DEVICE_TABLE(of, tof_of_match);

// 定义一个标准 I2C 驱动结构体
static struct i2c_driver tof_driver = {
    .driver = {
        .name = "tof-sensor",
        .of_match_table = tof_of_match,
    },
    .probe = tof_probe,
    .remove = tof_remove,
};

// 一键注册 I2C 驱动的宏
module_i2c_driver(tof_driver);

MODULE_LICENSE("GPL");
MODULE_AUTHOR("Xiaoyang");
MODULE_DESCRIPTION("TOF Sensor Interrupt Driver");
🛠️ 2. 编写独立编译的 Makefile
内核模块的编译和普通的 C++ 应用程序完全不同，它必须借助内核的源码树来编译自己。请在 04 目录下新建 Makefile（注意缩进必须是 Tab 键）：


# 指向内核源码目录
KERNELDIR := /home/alientek/RK3568/SDK/linux/rk3568_linux_sdk/kernel
CURRENT_PATH := $(shell pwd)

# 💥 核心：指定目标架构为 arm64，并指定正点原子的交叉编译器前缀
ARCH ?= arm64
CROSS_COMPILE ?= /opt/atk-dlrk356x-toolchain/bin/aarch64-buildroot-linux-gnu-

obj-m := tof_irq.o

build: kernel_modules

kernel_modules:
	$(MAKE) -C $(KERNELDIR) M=$(CURRENT_PATH) ARCH=$(ARCH) CROSS_COMPILE=$(CROSS_COMPILE) modules

clean:
	$(MAKE) -C $(KERNELDIR) M=$(CURRENT_PATH) ARCH=$(ARCH) CROSS_COMPILE=$(CROSS_COMPILE) clean



把这两个文件建好之后，直接在你的 Ubuntu 虚拟机 04 目录下执行 make。一切顺利的话，你会得到一个绿油油的 tof_irq.ko 内核驱动模块文件。









看着终端里的 LD [M] /home/alientek/nfs/yinshipin/04/tof_irq.ko，绿油油的成功编译提示，这说明我们刚才补上的 ARCH=arm64 和交叉编译器参数直接把内核模块拿下了！

