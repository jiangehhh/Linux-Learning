🚀 终极视觉进化：给 main.cpp 注入 RGB 血液
我为你写了一个超轻量级的“距离转 RGB 颜色插值算法”。它会把 0 ~ 600mm 这个咱们最关注的近场抓取距离，完美映射为“红 -> 橙 -> 黄 -> 绿 -> 蓝”的渐变色谱。
请打开你的 main.cpp，用下面这段代码完整替换它：
C++
#include <stdio.h>
#include <fcntl.h>
#include <sys/ioctl.h>
#include <linux/i2c-dev.h>
#include <unistd.h>
#include "vl53l8cx_api.h"
#include "platform.h"
// 🎨 [核心渲染引擎] 将深度数字转化为 ANSI 真彩色块
void print_heatmap_cell(int32_t distance) {
    int r = 0, g = 0, b = 0;    
    // 设定热力图的感知范围 (0 ~ 600mm)
    int d = distance;
    if (d < 0) d = 0;
    if (d > 600) d = 600;
    // 线性插值计算渐变色 (越近越红，越远越蓝)
    if (d < 150) { 
        // 0~150mm: 极度危险/贴脸 -> 纯红色到橙色
        r = 255; g = (d * 255) / 150; b = 0;
    } else if (d < 300) { 
        // 150~300mm: 预警距离 -> 橙色到黄色
        r = 255 - ((d - 150) * 255) / 150; g = 255; b = 0;
    } else if (d < 450) { 
        // 300~450mm: 安全距离 -> 黄色到青绿色
        r = 0; g = 255; b = ((d - 300) * 255) / 150;
    } else { 
        // 450~600mm: 较远距离 -> 青色到深蓝色
        r = 0; g = 255 - ((d - 450) * 255) / 150; b = 255;
    }
    // ANSI 控制码解析:
    // \033[48;2;R;G;Bm -> 设定背景 RGB 颜色
    // \033[38;2;0;0;0m -> 设定字体为纯黑色，方便在亮色背景上看清数字
    // \033[0m          -> 重置所有颜色，防止影响终端其他输出
    printf("\033[48;2;%d;%d;%dm\033[38;2;0;0;0m %4d \033[0m", r, g, b, distance);
}
int main() {
    VL53L8CX_Configuration Dev;    
    Dev.platform.address = 0x29;
    Dev.platform.fd = open("/dev/i2c-3", O_RDWR);    
    if (Dev.platform.fd < 0) {
        perror("❌ 无法打开 /dev/i2c-3");
        return -1;
    }
    // 强行绑定，打双保险
    if (ioctl(Dev.platform.fd, I2C_SLAVE, 0x29) < 0) {
        perror("❌ 无法绑定 I2C 地址");
        return -1;
    }   
    printf("==========================================\n");
    printf("🔍 [诊断] 正在进行硬件物理探活...\n");
    uint8_t sensor_id = 0;
    VL53L8CX_WrByte(&(Dev.platform), 0x7fff, 0x00); 
    if (VL53L8CX_RdByte(&(Dev.platform), 0x0000, &sensor_id) == 0) {
        printf("✅ 成功连通！硬件 ID: 0x%02X\n", sensor_id);
    } else {
        printf("❌ 致命错误：读不到数据。\n");
        close(Dev.platform.fd);
        return -1;
    }
    printf("==========================================\n\n");

    printf("⏳ 正在自动切片下载 85KB 固件...\n");
    
    uint8_t status = vl53l8cx_init(&Dev);
    if(status != 0) {
        printf("❌ 固件初始化失败，错误码: %d\n", status);
        close(Dev.platform.fd);
        return -1;
    }
    vl53l8cx_set_resolution(&Dev, VL53L8CX_RESOLUTION_8X8);
    vl53l8cx_set_ranging_frequency_hz(&Dev, 15);
    vl53l8cx_start_ranging(&Dev);   
    // 清除一次屏幕（仅在开头清屏，避免疯狂闪烁）
    printf("\x1B[2J");   
    VL53L8CX_ResultsData Results;    
    while(1) {
        uint8_t isReady = 0;
        vl53l8cx_check_data_ready(&Dev, &isReady);
        
        if(isReady) {
            vl53l8cx_get_ranging_data(&Dev, &Results);
            
            // \x1B[H 是一个神仙操作：它只把光标移回屏幕左上角，直接覆盖旧字，绝对不闪屏！
            printf("\x1B[H"); 
            printf("📊 === VL53L8CX 8x8 实时深度热力图 (近场红/远场蓝) ===\n\n");
            
            for(int r = 0; r < 8; r++) {
                for(int c = 0; c < 8; c++) {
                    int zone_idx = r * 8 + c;
                    int32_t distance = Results.distance_mm[zone_idx];                  
                    // 调用我们刚写的热力渲染函数
                    print_heatmap_cell(distance);         
                    // 每个格子之间加个小空格
                    printf(" ");
                }
                // 打印完一行后，换两行，拉开纵向间距，让矩阵更接近正方形
                printf("\n\n");
            }
        }
        usleep(50000); // 采样间隔
    }
    close(Dev.platform.fd);
    return 0;
}
